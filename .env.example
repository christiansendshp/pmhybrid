DATABASE_URL="postgresql://pmhybrid:pmhybrid@localhost:5436/pmhybrid?schema=public"
# Signs every access and refresh token. "change-me" is fine on a laptop, but a
# production start refuses anything under 32 characters or a known placeholder
# (Roadmap SECURITY-04a). Generate one: openssl rand -base64 48
JWT_SECRET="change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000
SYNC_DEFAULT_INTERVAL_MINUTES=5
GIT_PROVIDER_TYPE=local
# Required only when GIT_PROVIDER_TYPE=github.
GITHUB_TOKEN=
# HMAC secret GitHub signs webhook deliveries with; empty disables /webhooks/github (Roadmap GAP-29).
GITHUB_WEBHOOK_SECRET=
# Scheduled sync on (default) or off; manual sync always works. The e2e suite sets false.
SYNC_SCHEDULER_ENABLED=true
# Browser origins allowed to call the API, comma-separated ("*" allows every one). Unset: the web app's dev
# origins outside production, none in production (Roadmap SECURITY-04b1).
# CORS_ORIGINS=https://pm.example.com
# How many revisions of each document to keep; older ones are deleted daily at 03:00 (Roadmap BUG-07c). 0 keeps everything.
DOCUMENT_REVISION_RETENTION=200
