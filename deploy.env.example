# The settings of docker-compose.prod.yml (Roadmap IMPROVEMENT-02c). Copy to .env.prod,
# fill it in, and keep it out of version control. See docs/deployment.md.

# The database's password: letters and digits only, it is put in a connection URL.
POSTGRES_PASSWORD=

# Signs every session. At least 32 characters and not a placeholder, or the API refuses to
# start: openssl rand -base64 48
JWT_SECRET=

# The address the web app is opened at (scheme, host and port), and the address the browser
# reaches the API at. Without the first the browser blocks the API's answers.
CORS_ORIGINS=http://localhost:8080
API_BASE_URL=http://localhost:3000

# The first administrator, created on the first start and only while there is none. The
# password is at least 12 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Ports published on the host.
WEB_PORT=8080
API_PORT=3000

# Where the projects' docs folders are on the host (GIT_PROVIDER_TYPE=local), or a GitHub
# token and webhook secret (GIT_PROVIDER_TYPE=github).
PROJECTS_DIR=./deploy/projects
GIT_PROVIDER_TYPE=local
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
