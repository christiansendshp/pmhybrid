// PM Hub domain model. Source of truth for field/relation meaning:
// docs/domain-model.md. Do not add fields here without updating that doc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Actors (brief §3) — polymorphic HUMAN/AI_AGENT, avoids field duplication.
// ---------------------------------------------------------------------------

enum ActorKind {
  HUMAN
  AI_AGENT
}

model Actor {
  id          String    @id @default(uuid())
  kind        ActorKind
  displayName String
  avatarUrl   String?
  email       String?   @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  credential   UserCredential?
  agentProfile AgentProfile?

  actorRoles        ActorRole[]
  memberships       ProjectMember[]
  assignedTasks     Task[]           @relation("TaskAssignee")
  // The tasks it was asked to review while they are in QA (Roadmap SUBTASK-09.1); never an assignment.
  reviewingTasks    Task[]           @relation("TaskReviewer")
  taskAssignments   TaskAssignment[] @relation("AssignmentActor")
  assignedByEvents  TaskAssignment[] @relation("AssignmentBy")
  auditEvents       AuditEvent[]
  notifications     Notification[]
  resolvedConflicts Conflict[]       @relation("ConflictResolvedBy")
  apiKeys           ApiKey[]
  taskComments      TaskComment[]    @relation("CommentAuthor")
  leadProjects      Project[]        @relation("ProjectLead")
  idempotencyKeys   IdempotencyKey[]
  ledgerEvents      AgentLogEvent[]  @relation("LedgerAgent")
  seenProjects      ProjectSeen[]
}

model UserCredential {
  id             String  @id @default(uuid())
  actorId        String  @unique
  actor          Actor   @relation(fields: [actorId], references: [id])
  passwordHash   String?
  authProvider   String  @default("LOCAL")
  providerUserId String?
}

model AgentProfile {
  id           String @id @default(uuid())
  actorId      String @unique
  actor        Actor  @relation(fields: [actorId], references: [id])
  providerType String
  configJson   Json?

  // Identity (Roadmap TASK-01, EPIC-02). `modelName` is the model the agent runs
  // as; `stageRole` says whether it develops, reviews (QA) or both. The strings
  // the agent writes in the documents live in `identifiers`.
  modelName   String?
  stageRole   AgentStageRole @default(BOTH)
  identifiers AgentIdentifier[]
}

enum AgentStageRole {
  DEVELOPER
  QA
  BOTH
}

enum AgentIdentifierKind {
  LEDGER_NAME
  ALIAS
}

/// A string an agent goes by in the documents: its ledger name (the one exact
/// string it passes to the skill, which compares it exactly) or an alias it has
/// written. `key` is the normalized form (case, spacing and Unicode composition
/// folded away) and is unique across the instance, so a name resolves to one
/// agent or to none.
model AgentIdentifier {
  id             String              @id @default(uuid())
  agentProfileId String
  agentProfile   AgentProfile        @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  kind           AgentIdentifierKind
  value          String
  key            String              @unique
  createdAt      DateTime            @default(now())

  @@index([agentProfileId])
}

// Controlled API access for AI agents (brief §27, §28, Roadmap GAP-15). The
// plaintext key is `pmh_<64 hex chars>`, shown to the caller exactly once at
// creation and never persisted: only `secretHash` (SHA-256 of the part after
// `pmh_`) is stored, and it doubles as the lookup key since it is
// deterministic — no separate salt, unlike UserCredential.passwordHash
// (argon2id), because this secret is generated with 256 bits of entropy, not
// user-chosen (see Stack_Tecnologies.md ADR-009). `prefix` (the first 8 hex
// chars) is plaintext and display-only, so an admin can tell keys apart
// without ever seeing the full secret again.
/// What an API key may do (Roadmap SECURITY-04b2). READ_ONLY is refused every
/// request that is not a read (GET, HEAD, OPTIONS); READ_WRITE, the default, is
/// what every key was before this existed.
enum ApiKeyScope {
  READ_ONLY
  READ_WRITE
}

model ApiKey {
  id         String      @id @default(uuid())
  actorId    String
  actor      Actor       @relation(fields: [actorId], references: [id])
  name       String?
  prefix     String
  secretHash String      @unique
  createdAt  DateTime    @default(now())
  revokedAt  DateTime?
  /// A key stops working at this moment; null never expires (how every key was).
  expiresAt  DateTime?
  scope      ApiKeyScope @default(READ_WRITE)
  /// When the key last authenticated a request, to a minute's precision.
  lastUsedAt DateTime?

  @@index([actorId])
}

// ---------------------------------------------------------------------------
// RBAC (brief §4)
// ---------------------------------------------------------------------------

enum RoleScope {
  GLOBAL
  PROJECT
}

model Role {
  id              String           @id @default(uuid())
  name            String
  scope           RoleScope
  isSystem        Boolean          @default(false)
  rolePermissions RolePermission[]
  actorRoles      ActorRole[]

  @@unique([name, scope])
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model ActorRole {
  id        String   @id @default(uuid())
  actorId   String
  roleId    String
  projectId String? // null = global assignment, set = project-scoped
  actor     Actor    @relation(fields: [actorId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])

  // Does NOT dedupe global grants (projectId IS NULL) — Postgres treats NULL
  // as distinct in unique constraints. See the follow-up partial index in
  // migration.sql / docs/domain-model.md.
  @@unique([actorId, roleId, projectId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  actorId   String
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)
  project   Project  @relation(fields: [projectId], references: [id])
  actor     Actor    @relation(fields: [actorId], references: [id])

  @@unique([projectId, actorId])
}

// ---------------------------------------------------------------------------
// Hierarchy (brief §5) — no level mandatory, all nullable/app-level.
// ---------------------------------------------------------------------------

model Phase {
  id          String  @id @default(uuid())
  // The id of the Roadmap entry (`type: PHASE`) this phase mirrors, opaque like
  // Task.externalId; null for a phase made in the app (Roadmap GAP-35d).
  externalId  String?
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  name        String
  order       Int
  description String?
  status      String?
  epics       Epic[]
  tasks       Task[]

  @@unique([projectId, externalId])
}

model Epic {
  id          String     @id @default(uuid())
  // The id of the Roadmap entry (`type: EPIC`) this epic mirrors; null for one
  // made in the app (Roadmap GAP-35d).
  externalId  String?
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  phaseId     String?
  phase       Phase?     @relation(fields: [phaseId], references: [id])
  name        String
  order       Int
  description String?
  status      String?
  templates   Template[]
  tasks       Task[]

  @@unique([projectId, externalId])
}

model Template {
  id          String  @id @default(uuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  epicId      String?
  epic        Epic?   @relation(fields: [epicId], references: [id])
  name        String
  order       Int
  description String?
  tasks       Task[]
}

// ---------------------------------------------------------------------------
// Task (brief §6-9, §23 — no separate Subtask; self-referential Task)
// ---------------------------------------------------------------------------

enum TaskStatus {
  PENDIENTE
  ASIGNADA
  EN_DESARROLLO
  QA
  TERMINADA
}

enum RoadmapTable {
  ACTIVE
  NEAR_TERM
  BLOCKED
}

enum TaskSourceOrigin {
  UI
  ROADMAP
  // Imported from work the ledger carries that the Roadmap does not (Roadmap TASK-34); it has no row.
  AGENTSLOG
}

model Task {
  id         String  @id @default(uuid())
  externalId String? // Roadmap row ID, opaque string, never parsed for grammar

  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  phaseId      String?
  phase        Phase?    @relation(fields: [phaseId], references: [id])
  epicId       String?
  epic         Epic?     @relation(fields: [epicId], references: [id])
  templateId   String?
  template     Template? @relation(fields: [templateId], references: [id])
  parentTaskId String?
  parentTask   Task?     @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]    @relation("Subtasks")

  // What the Roadmap entry says it is (`type: GAP`, `BUG`, `TASK`...), upper-cased;
  // null for a row of a table format, which has no such field (Roadmap GAP-35c).
  // Not an enum: the taxonomy is extensible per project.
  entryType       String?
  title           String
  description     String?
  status          TaskStatus @default(PENDIENTE)
  // When the task entered its current status (Roadmap TASK-11): set by every path that
  // changes the status (`statusStamp`), so the time in a state can be read without the
  // audit trail. It is the creation time for a task that has not moved.
  statusChangedAt DateTime   @default(now())
  // The stage the ledger's latest entry for the task gives (Roadmap TASK-14), as of the last sync:
  // null when the task has no entry or its latest says nothing of the stage. Only read, to show
  // when the ledger and the board disagree; it never moves the task.
  ledgerStage     TaskStatus?
  // The start of the summary of that same entry, at most LEDGER_NOTE_LENGTH characters (Roadmap TASK-13):
  // what the card shows, on hover or focus, as the last thing the ledger said about the task.
  ledgerNote      String?
  priority        String?
  progressPercent Int?

  // Normalization of a long Roadmap title by the LLM (Roadmap GAP-39d). A title
  // read from the document with more than 10 words is queued (PENDING) and,
  // once normalized, `title` holds the short one while `originalTitle` keeps
  // what the document says: Roadmap.md is never written by normalization, and
  // sync compares the document's title against `originalTitle ?? title`, so a
  // normalized title is not reverted by an unrelated change to the row. A title
  // a person edits, or the document changes, resets all of this.
  originalTitle              String?
  titleNormalization         TitleNormalizationStatus?
  // Why it failed, already free of any secret (shown, so a retry can be decided).
  titleNormalizationError    String?
  // How many times in a row it failed (Roadmap BUG-14): the syncs that follow try
  // a failed task again until this reaches the limit; a person's retry, a new
  // configuration and a success start it again from zero.
  titleNormalizationAttempts Int                       @default(0)
  titleNormalizedAt          DateTime?
  // The description normalization wrote: while `description` still equals it the
  // text is the system's to replace; once a person edits it, it is theirs.
  generatedDescription       String?

  startDate     DateTime?
  estimatedDate DateTime?
  dueDate       DateTime?
  // When the task became TERMINADA (Roadmap GAP-36d); null while it is not. Set
  // and cleared by `completedAtFor`, never by hand, whichever path moved it.
  completedAt   DateTime?

  assigneeActorId  String?
  assignee         Actor?    @relation("TaskAssignee", fields: [assigneeActorId], references: [id])
  // Who was asked to review the task and since when (Roadmap SUBTASK-09.1): set on the way into QA,
  // cleared by whatever takes the task out of it. Kept in Postgres only (no document has a field for
  // it) and apart from the assignee: it changes neither Workload nor the assignee lock.
  reviewerActorId   String?
  reviewer          Actor?    @relation("TaskReviewer", fields: [reviewerActorId], references: [id], onDelete: SetNull)
  reviewRequestedAt DateTime?
  assigneeLockedAt DateTime?

  rawOwner       String?
  ownerClaimedAt DateTime?

  acceptanceCriteria String?

  roadmapTable   RoadmapTable?
  blockedReason  String?
  neededDecision String?
  // When the task entered the Blocked table (Roadmap TASK-31); null while it is not in it.
  blockedSince   DateTime?

  sourceOrigin TaskSourceOrigin

  lastSyncedContentHash String?
  lastSyncedAt          DateTime?

  // Soft delete (docs/domain-model.md): a removed task keeps its row, audit
  // trail and externalId, so sync never recreates it from a stale Roadmap row.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dependencies    TaskDependency[] @relation("DependentTask")
  dependents      TaskDependency[] @relation("DependsOnTask")
  assignments     TaskAssignment[]
  agentLogEvents  AgentLogEvent[]
  comments        TaskComment[]
  idempotencyKeys IdempotencyKey[]

  @@unique([projectId, externalId])
  @@index([projectId, status])
  @@index([projectId, titleNormalization])
  @@index([projectId, status, statusChangedAt])
  @@index([parentTaskId])
  @@index([assigneeActorId])
}

enum TitleNormalizationStatus {
  PENDING
  DONE
  FAILED
}

model TaskDependency {
  id              String  @id @default(uuid())
  taskId          String
  task            Task    @relation("DependentTask", fields: [taskId], references: [id])
  dependsOnTaskId String?
  dependsOnTask   Task?   @relation("DependsOnTask", fields: [dependsOnTaskId], references: [id])
  rawExternalRef  String?
  // The document has listed this dependency (seen by sync, or written by the
  // add-dependency write-back). Only such a dependency is removed when the
  // document later stops listing it (Roadmap GAP-35e).
  inDocument      Boolean @default(false)

  @@index([taskId])
  @@index([dependsOnTaskId])
}

model TaskAssignment {
  id                String    @id @default(uuid())
  taskId            String
  task              Task      @relation(fields: [taskId], references: [id])
  actorId           String
  actor             Actor     @relation("AssignmentActor", fields: [actorId], references: [id])
  assignedAt        DateTime  @default(now())
  unassignedAt      DateTime?
  assignedByActorId String
  assignedBy        Actor     @relation("AssignmentBy", fields: [assignedByActorId], references: [id])
  reason            String?
}

// Roadmap GAP-31: a live, interactive comment thread any project member
// (human via REST, agent via MCP) writes directly through the app. Distinct
// from AgentLogEvent, which is a one-way, read-only mirror of Agentslog.md
// entries populated by document ingestion (agentName is a denormalized
// string there, not an Actor FK, since a log's author need not be a
// registered Actor) -- TaskComment has no document counterpart by design
// (see docs/Stack_Tecnologies.md ADR-019) and is never written back to
// Roadmap.md/Agentslog.md.
model TaskComment {
  id            String   @id @default(uuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id])
  authorActorId String
  author        Actor    @relation("CommentAuthor", fields: [authorActorId], references: [id])
  body          String
  createdAt     DateTime @default(now())

  @@index([taskId, createdAt])
}

// ---------------------------------------------------------------------------
// Documents / sync / audit (brief §10-13, §25-26)
// ---------------------------------------------------------------------------

enum DocumentKind {
  ROADMAP
  AGENTSLOG
  PRODUCT_DESCRIPTION
  STACK_TECH
  FEATURES
  AGENTS_RULES
}

enum RevisionSource {
  SYNC
  UI
  API
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
  WEBHOOK
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
  RUNNING
}

enum AuditOrigin {
  UI
  ROADMAP
  AGENTSLOG
  SYNC
  API
  SYSTEM
}

enum ConflictKind {
  ROADMAP_ROW_DISAPPEARED_NO_TERMINAL_LOG
  CONCURRENT_FIELD_EDIT
  WRITE_BACK_COLLISION
  // The document gives a status that is in neither vocabulary (Roadmap GAP-35b).
  UNRECOGNIZED_STATUS
  // The document closes a task that is in QA in a project that requires approval (Roadmap GAP-41, DEC-006).
  QA_APPROVAL_REQUIRED
}

enum ConflictResolutionKind {
  KEEP_LOCAL
  KEEP_EXTERNAL
  MANUAL_EDIT
  DISMISSED
  RESTORE_ROW
}

model Document {
  id            String             @id @default(uuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id])
  kind          DocumentKind
  filePath      String
  lastKnownHash String?
  lastSyncedAt  DateTime?
  lastSyncRunId String?
  revisions     DocumentRevision[]

  @@unique([projectId, kind])
}

model DocumentRevision {
  id          String         @id @default(uuid())
  documentId  String
  document    Document       @relation(fields: [documentId], references: [id])
  contentHash String
  rawContent  String
  capturedAt  DateTime       @default(now())
  source      RevisionSource

  // The newest-first walk that trims a document's history (Roadmap BUG-07c).
  @@index([documentId, capturedAt])
}

model SyncRun {
  id         String      @id @default(uuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id])
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  trigger    SyncTrigger
  status     SyncStatus
  summary    Json?

  @@index([projectId, startedAt])
}

model AgentLogEvent {
  id                       String   @id @default(uuid())
  projectId                String
  project                  Project  @relation(fields: [projectId], references: [id])
  taskExternalId           String?
  taskId                   String?
  task                     Task?    @relation(fields: [taskId], references: [id])
  agentName                String
  // The agent that name is (Roadmap TASK-02), when it is exactly one; null for a name that is
  // no agent's or is two agents'. `agentName` stays what was written.
  agentActorId             String?
  agentActor               Actor?   @relation("LedgerAgent", fields: [agentActorId], references: [id])
  timestampFromLog         DateTime
  statusWord               String
  summary                  String
  files                    String
  verify                   String
  followUp                 String
  // What the status word says in the skill's vocabulary (Roadmap TASK-06): IN_PROGRESS, REVIEW,
  // ASSIGNED, PAUSE, DONE, DONE_PARTIAL or TODO; null for a word it does not know. The qualifier is
  // what follows the word as written; the two lines are the optional `Handoff` and `Review` ones.
  // `statusWord` stays what was written, and BR-003's terminal check stays the exact word DONE.
  canonicalStatus          String?
  statusQualifier          String?
  handoffTo                String?
  reviewResult             String?
  rawEntryHash             String
  sourceDocumentRevisionId String
  createdAt                DateTime @default(now())

  // Scoped per project, not global — two unrelated projects' agents could
  // coincidentally log byte-identical entry text (same summary, same
  // relative timestamp shape); a bare global unique would silently drop
  // the second project's entry as a "duplicate" of the first's.
  @@unique([projectId, rawEntryHash])
  @@index([agentActorId])
}

model Conflict {
  id                 String                  @id @default(uuid())
  projectId          String
  project            Project                 @relation(fields: [projectId], references: [id])
  kind               ConflictKind
  entityType         String
  entityId           String
  localVersion       Json
  externalVersion    Json?
  detectedAt         DateTime                @default(now())
  resolvedAt         DateTime?
  resolvedByActorId  String?
  resolvedBy         Actor?                  @relation("ConflictResolvedBy", fields: [resolvedByActorId], references: [id])
  resolutionStrategy ConflictResolutionKind?

  @@index([projectId, resolvedAt])
}

model AuditEvent {
  id            String      @id @default(uuid())
  // Null only for an event about a global entity (e.g. an Actor) — lets a
  // project's whole change history be one indexed query (brief §25, §31).
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id])
  actorId       String?
  actor         Actor?      @relation(fields: [actorId], references: [id])
  entityType    String
  entityId      String
  operation     String
  previousValue Json?
  newValue      Json?
  origin        AuditOrigin
  occurredAt    DateTime    @default(now())

  @@index([entityType, entityId, occurredAt])
  @@index([projectId, occurredAt])
}

model Notification {
  id        String    @id @default(uuid())
  actorId   String
  actor     Actor     @relation(fields: [actorId], references: [id])
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// Project (brief §2, §16)
// ---------------------------------------------------------------------------

enum ProgressRollupStrategy {
  EQUAL_WEIGHT_AVERAGE
  LEAF_EQUAL_WEIGHT
}

// Roadmap GAP-32: the one team member (human or AI agent) primarily
// responsible for this project. Named `lead`, not `owner`, to avoid
// colliding with the RBAC `OWNER` role (ActorRole) — that's a permission
// grant multiple actors can hold at once; this is a single organizational
// designation, independent of permissions. Nullable and optional: a
// project can exist with nobody designated yet.
model Project {
  id                     String                 @id @default(uuid())
  name                   String
  description            String?
  repoUrl                String?
  docsPath               String
  syncIntervalMinutes    Int                    @default(5)
  // A task closed less than this many minutes after its first IN_PROGRESS in the ledger is
  // flagged as an instant close (Roadmap TASK-12).
  instantCloseMinutes    Int                    @default(5)
  // Advisory limits on the work in progress (Roadmap TASK-15): tasks EN_DESARROLLO, tasks in QA, and tasks
  // EN_DESARROLLO of one agent. Null is no limit. They warn on the board and never block a move.
  wipLimitDevelopment    Int?
  wipLimitQa             Int?
  wipLimitAgent          Int?
  // A move to QA needs a reviewer who can approve and is not the assignee, and a document cannot close a
  // task in QA by itself (Roadmap SUBTASK-09.2, GAP-41, DEC-006). Off: nothing is asked.
  qaApprovalRequired     Boolean  @default(false)
  // A move to QA, its approval and its return are written into the ledger as the skill's review stage
  // (REVIEW entries with Handoff and Review), for a project whose skill version accepts them (Roadmap
  // TASK-08, GAP-40). Off: a move to QA writes nothing, as before.
  ledgerQaHandoff        Boolean  @default(false)
  progressRollupStrategy ProgressRollupStrategy @default(EQUAL_WEIGHT_AVERAGE)
  nextTaskSeq            Int                    @default(1)
  status                 String                 @default("ACTIVE")
  createdAt              DateTime               @default(now())

  leadActorId String?
  lead        Actor?  @relation("ProjectLead", fields: [leadActorId], references: [id])

  phases          Phase[]
  epics           Epic[]
  templates       Template[]
  tasks           Task[]
  members         ProjectMember[]
  actorRoles      ActorRole[]
  documents       Document[]
  syncRuns        SyncRun[]
  agentLogEvents  AgentLogEvent[]
  conflicts       Conflict[]
  notifications   Notification[]
  auditEvents     AuditEvent[]
  idempotencyKeys IdempotencyKey[]
  seenBy          ProjectSeen[]
}

/// Until when a person has seen the news of a project (Roadmap TASK-38): the marker "Desde tu última visita"
/// counts from. Moved only by the person, with an explicit call, so opening one task from the list never hides
/// the rest; a person with no row for a project is read from 7 days back.
model ProjectSeen {
  actorId   String
  actor     Actor    @relation(fields: [actorId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seenAt    DateTime

  @@id([actorId, projectId])
}

/// A task-creation request the API already answered (Roadmap BUG-07b): a client
/// that retries with the same Idempotency-Key gets the task the first request
/// made instead of a second one. Scoped to (project, actor) so one caller's
/// key never reveals another's task; `requestHash` catches a key reused for a
/// different request; a row is dropped once its retention window has passed.
model IdempotencyKey {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  actorId     String
  actor       Actor    @relation(fields: [actorId], references: [id])
  key         String
  requestHash String
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([projectId, actorId, key])
  @@index([projectId, createdAt])
}

/// The instance's LLM configuration (Roadmap GAP-39a): one row, id "instance".
/// PM Hub has no organization model -- the instance is the unit, with global
/// roles and permissions -- so the configuration is per instance, managed with
/// the global `settings.manage` permission. The database is the only source:
/// nothing here is read from the environment. `apiKeyEncrypted` is AES-256-GCM
/// ciphertext (`secret-crypto.util.ts`); it is never selected into a response,
/// a log line or an audit event. `provider` is validated against the shared
/// LLM_PROVIDERS list rather than being an enum, so a provider can be added
/// without a migration.
model LlmSettings {
  id              String   @id @default("instance")
  provider        String   @default("ANTHROPIC")
  model           String
  enabled         Boolean  @default(false)
  apiKeyEncrypted String?
  temperature     Float?
  timeoutMs       Int      @default(30000)
  maxTokens       Int      @default(1024)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
