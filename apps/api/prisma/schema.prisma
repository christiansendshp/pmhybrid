// PM Hub domain model. Source of truth for field/relation meaning:
// docs/domain-model.md. Do not add fields here without updating that doc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Actors (brief §3) — polymorphic HUMAN/AI_AGENT, avoids field duplication.
// ---------------------------------------------------------------------------

enum ActorKind {
  HUMAN
  AI_AGENT
}

model Actor {
  id           String    @id @default(uuid())
  kind         ActorKind
  displayName  String
  avatarUrl    String?
  email        String?   @unique
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  credential   UserCredential?
  agentProfile AgentProfile?

  actorRoles       ActorRole[]
  memberships      ProjectMember[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  taskAssignments  TaskAssignment[] @relation("AssignmentActor")
  assignedByEvents TaskAssignment[] @relation("AssignmentBy")
  auditEvents      AuditEvent[]
  notifications    Notification[]
  resolvedConflicts Conflict[]      @relation("ConflictResolvedBy")
}

model UserCredential {
  id             String  @id @default(uuid())
  actorId        String  @unique
  actor          Actor   @relation(fields: [actorId], references: [id])
  passwordHash   String?
  authProvider   String  @default("LOCAL")
  providerUserId String?
}

model AgentProfile {
  id           String @id @default(uuid())
  actorId      String @unique
  actor        Actor  @relation(fields: [actorId], references: [id])
  providerType String
  configJson   Json?
}

// ---------------------------------------------------------------------------
// RBAC (brief §4)
// ---------------------------------------------------------------------------

enum RoleScope {
  GLOBAL
  PROJECT
}

model Role {
  id              String            @id @default(uuid())
  name            String
  scope           RoleScope
  isSystem        Boolean           @default(false)
  rolePermissions RolePermission[]
  actorRoles      ActorRole[]

  @@unique([name, scope])
}

model Permission {
  id              String            @id @default(uuid())
  key             String            @unique
  description     String
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model ActorRole {
  id        String   @id @default(uuid())
  actorId   String
  roleId    String
  projectId String? // null = global assignment, set = project-scoped
  actor     Actor    @relation(fields: [actorId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])

  // Does NOT dedupe global grants (projectId IS NULL) — Postgres treats NULL
  // as distinct in unique constraints. See the follow-up partial index in
  // migration.sql / docs/domain-model.md.
  @@unique([actorId, roleId, projectId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  actorId   String
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)
  project   Project  @relation(fields: [projectId], references: [id])
  actor     Actor    @relation(fields: [actorId], references: [id])

  @@unique([projectId, actorId])
}

// ---------------------------------------------------------------------------
// Hierarchy (brief §5) — no level mandatory, all nullable/app-level.
// ---------------------------------------------------------------------------

model Phase {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  name        String
  order       Int
  description String?
  status      String?
  epics       Epic[]
  tasks       Task[]
}

model Epic {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  phaseId     String?
  phase       Phase?    @relation(fields: [phaseId], references: [id])
  name        String
  order       Int
  description String?
  status      String?
  templates   Template[]
  tasks       Task[]
}

model Template {
  id          String  @id @default(uuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  epicId      String?
  epic        Epic?   @relation(fields: [epicId], references: [id])
  name        String
  order       Int
  description String?
  tasks       Task[]
}

// ---------------------------------------------------------------------------
// Task (brief §6-9, §23 — no separate Subtask; self-referential Task)
// ---------------------------------------------------------------------------

enum TaskStatus {
  PENDIENTE
  ASIGNADA
  EN_DESARROLLO
  QA
  TERMINADA
}

enum RoadmapTable {
  ACTIVE
  NEAR_TERM
  BLOCKED
}

enum TaskSourceOrigin {
  UI
  ROADMAP
}

model Task {
  id          String  @id @default(uuid())
  externalId  String? // Roadmap row ID, opaque string, never parsed for grammar

  projectId    String
  project      Project @relation(fields: [projectId], references: [id])
  phaseId      String?
  phase        Phase?  @relation(fields: [phaseId], references: [id])
  epicId       String?
  epic         Epic?   @relation(fields: [epicId], references: [id])
  templateId   String?
  template     Template? @relation(fields: [templateId], references: [id])
  parentTaskId String?
  parentTask   Task?   @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]  @relation("Subtasks")

  title       String
  description String?
  status      TaskStatus @default(PENDIENTE)
  priority    String?
  progressPercent Int?

  startDate     DateTime?
  estimatedDate DateTime?
  dueDate       DateTime?

  assigneeActorId  String?
  assignee         Actor?    @relation("TaskAssignee", fields: [assigneeActorId], references: [id])
  assigneeLockedAt DateTime?

  rawOwner       String?
  ownerClaimedAt DateTime?

  acceptanceCriteria String?

  roadmapTable   RoadmapTable?
  blockedReason  String?
  neededDecision String?

  sourceOrigin TaskSourceOrigin

  lastSyncedContentHash String?
  lastSyncedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dependencies    TaskDependency[] @relation("DependentTask")
  dependents      TaskDependency[] @relation("DependsOnTask")
  assignments     TaskAssignment[]
  agentLogEvents  AgentLogEvent[]

  @@unique([projectId, externalId])
  @@index([projectId, status])
}

model TaskDependency {
  id              String  @id @default(uuid())
  taskId          String
  task            Task    @relation("DependentTask", fields: [taskId], references: [id])
  dependsOnTaskId String?
  dependsOnTask   Task?   @relation("DependsOnTask", fields: [dependsOnTaskId], references: [id])
  rawExternalRef  String?
}

model TaskAssignment {
  id                String    @id @default(uuid())
  taskId            String
  task              Task      @relation(fields: [taskId], references: [id])
  actorId           String
  actor             Actor     @relation("AssignmentActor", fields: [actorId], references: [id])
  assignedAt        DateTime  @default(now())
  unassignedAt      DateTime?
  assignedByActorId String
  assignedBy        Actor     @relation("AssignmentBy", fields: [assignedByActorId], references: [id])
  reason            String?
}

// ---------------------------------------------------------------------------
// Documents / sync / audit (brief §10-13, §25-26)
// ---------------------------------------------------------------------------

enum DocumentKind {
  ROADMAP
  AGENTSLOG
  PRODUCT_DESCRIPTION
  STACK_TECH
  FEATURES
  AGENTS_RULES
}

enum RevisionSource {
  SYNC
  UI
}

enum SyncTrigger {
  SCHEDULED
  MANUAL
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILED
  RUNNING
}

enum AuditOrigin {
  UI
  ROADMAP
  AGENTSLOG
  SYNC
  API
  SYSTEM
}

enum ConflictKind {
  ROADMAP_ROW_DISAPPEARED_NO_TERMINAL_LOG
  CONCURRENT_FIELD_EDIT
  WRITE_BACK_COLLISION
}

enum ConflictResolutionKind {
  KEEP_LOCAL
  KEEP_EXTERNAL
  MANUAL_EDIT
  DISMISSED
}

model Document {
  id            String       @id @default(uuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id])
  kind          DocumentKind
  filePath      String
  lastKnownHash String?
  lastSyncedAt  DateTime?
  lastSyncRunId String?
  revisions     DocumentRevision[]

  @@unique([projectId, kind])
}

model DocumentRevision {
  id          String         @id @default(uuid())
  documentId  String
  document    Document       @relation(fields: [documentId], references: [id])
  contentHash String
  rawContent  String
  capturedAt  DateTime       @default(now())
  source      RevisionSource
}

model SyncRun {
  id         String      @id @default(uuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id])
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  trigger    SyncTrigger
  status     SyncStatus
  summary    Json?
}

model AgentLogEvent {
  id                       String    @id @default(uuid())
  projectId                String
  project                  Project   @relation(fields: [projectId], references: [id])
  taskExternalId           String?
  taskId                   String?
  task                     Task?     @relation(fields: [taskId], references: [id])
  agentName                String
  timestampFromLog         DateTime
  statusWord               String
  summary                  String
  files                    String
  verify                   String
  followUp                 String
  rawEntryHash             String
  sourceDocumentRevisionId String
  createdAt                DateTime  @default(now())

  // Scoped per project, not global — two unrelated projects' agents could
  // coincidentally log byte-identical entry text (same summary, same
  // relative timestamp shape); a bare global unique would silently drop
  // the second project's entry as a "duplicate" of the first's.
  @@unique([projectId, rawEntryHash])
}

model Conflict {
  id                 String                   @id @default(uuid())
  projectId          String
  project            Project                  @relation(fields: [projectId], references: [id])
  kind               ConflictKind
  entityType         String
  entityId           String
  localVersion       Json
  externalVersion    Json?
  detectedAt         DateTime                 @default(now())
  resolvedAt         DateTime?
  resolvedByActorId  String?
  resolvedBy         Actor?                   @relation("ConflictResolvedBy", fields: [resolvedByActorId], references: [id])
  resolutionStrategy ConflictResolutionKind?
}

model AuditEvent {
  id            String      @id @default(uuid())
  actorId       String?
  actor         Actor?      @relation(fields: [actorId], references: [id])
  entityType    String
  entityId      String
  operation     String
  previousValue Json?
  newValue      Json?
  origin        AuditOrigin
  occurredAt    DateTime    @default(now())

  @@index([entityType, entityId, occurredAt])
}

model Notification {
  id        String    @id @default(uuid())
  actorId   String
  actor     Actor     @relation(fields: [actorId], references: [id])
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Project (brief §2, §16)
// ---------------------------------------------------------------------------

enum ProgressRollupStrategy {
  EQUAL_WEIGHT_AVERAGE
  LEAF_EQUAL_WEIGHT
}

model Project {
  id                     String                 @id @default(uuid())
  name                   String
  description            String?
  repoUrl                String?
  docsPath               String
  syncIntervalMinutes    Int                    @default(5)
  progressRollupStrategy ProgressRollupStrategy @default(EQUAL_WEIGHT_AVERAGE)
  nextTaskSeq            Int                    @default(1)
  status                 String                 @default("ACTIVE")
  createdAt              DateTime               @default(now())

  phases        Phase[]
  epics         Epic[]
  templates     Template[]
  tasks         Task[]
  members       ProjectMember[]
  actorRoles    ActorRole[]
  documents     Document[]
  syncRuns      SyncRun[]
  agentLogEvents AgentLogEvent[]
  conflicts     Conflict[]
  notifications Notification[]
}
