  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch -p tsconfig.watch.json",
    "start:dev": "nest start --watch -p tsconfig.watch.json",
    "start:debug": "nest start --debug --watch -p tsconfig.watch.json",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:cov": "vitest run --config ./vitest.config.e2e.ts --coverage",
    "test:e2e:db:setup": "cross-env DATABASE_URL=postgresql://pmhybrid:pmhybrid@localhost:5436/pmhybrid_test?schema=public CI=true prisma migrate deploy && cross-env DATABASE_URL=postgresql://pmhybrid:pmhybrid@localhost:5436/pmhybrid_test?schema=public prisma db seed",
    "prisma:migrate": "cross-env CI=true prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
